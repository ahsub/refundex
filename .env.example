# Refundex — Umgebungsvariablen (Vorlage)
# =========================================
# Kopiere diese Datei nach .env und trage deine Werte ein.
# WICHTIG: .env niemals committen — ist in .gitignore gelistet.

# IBKR / CapTrader Flex Web Service
# Token aus: Client Portal → Performance & Reports → Flex Queries → Manage Service
IB_FLEX_TOKEN=dein_token_hier
# Query-ID aus: Client Portal → Performance & Reports → Flex Queries → (deine Query) → ID
IB_FLEX_QUERY_ID=deine_query_id_hier
